pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'docker build -t claude .'
            }
        }
        stage('Test') {
            steps {
                sh 'docker run -t claude python -m unittest discover -s tests'
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker run -p 5000:5000 claude'
            }
        }
    }
}