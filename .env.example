# ==========================================================
# STARK AVENGERS COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ==========================================================

# Server Port (Default: 4000)
PORT=4000

# Telegram Bot Credentials (Get from @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (Your personal Telegram User/Chat ID, e.g. 123456789)
TELEGRAM_CHAT_ID=

# AI API Keys (Optional - Fallback local NLP & speech models are built-in)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Daily End-of-Day Review Trigger Time (24-hour format HH:MM, e.g. 21:00)
EOD_REMINDER_TIME=21:00

# Enable macOS 24/7 Sleep Prevention Lock (caffeinate)
ENABLE_CAFFEINATE=true

# Enable Voice Audio Speech Synthesis (true/false)
ENABLE_VOICE_SYNTHESIS=true
